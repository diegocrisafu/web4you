# Copy this file to .env and fill it in. Never commit .env.
#
# Gmail: you must create an App Password, not your normal password.
#   myaccount.google.com -> Security -> 2-Step Verification -> App passwords
# Gmail caps you around 500 recipients/day. Do not go near that.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=websiteyou06@gmail.com
SMTP_PASS=your_16_char_app_password

# CASL requires all three of these in every commercial message. SENDER_ADDRESS
# must be a real mailing address you can receive post at -- send.py refuses to
# run while it still says "Your street address".
SENDER_NAME=Diego Crisafulli
SENDER_EMAIL=websiteyou06@gmail.com
SENDER_ADDRESS=Your street address, Montreal, QC, POSTAL

REPLY_TO=websiteyou06@gmail.com
DEFAULT_SUBJECT=Une idée pour {business}
